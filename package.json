{
  "name": "doodle-in-distress",
  "displayName": "doodle in distress",
  "description": "a hand-drawn pet you draw yourself. it lives in your panel and roasts your code.",
  "version": "0.0.1",
  "publisher": "fallhack26yeg",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "sidekick",
          "title": "doodle in distress",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "sidekick": [
        {
          "type": "webview",
          "id": "sidekick.view",
          "name": "doodle in distress"
        }
      ]
    },
    "commands": [
      { "command": "sidekick.next", "title": "doodle in distress: Next Stage" },
      { "command": "sidekick.reset", "title": "doodle in distress: Reset" },
      { "command": "sidekick.replay", "title": "doodle in distress: Replay Recorded Drawing" },
      { "command": "sidekick.chatHeist", "title": "doodle in distress: Open Chat (heist)" }
    ],
    "keybindings": [
      { "command": "sidekick.next", "key": "ctrl+alt+n", "mac": "cmd+alt+n" },
      { "command": "sidekick.reset", "key": "ctrl+alt+r", "mac": "cmd+alt+r" },
      { "command": "sidekick.replay", "key": "ctrl+alt+p", "mac": "cmd+alt+p" },
      { "command": "sidekick.chatHeist", "key": "ctrl+alt+i", "mac": "ctrl+cmd+i" },
      { "command": "sidekick.chatHeist", "key": "ctrl+alt+c", "mac": "ctrl+cmd+c" }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.4.0"
  }
}
